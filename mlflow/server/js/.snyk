# Snyk (https://snyk.io) policy file, patches or ignores known vulnerabilities.
version: v1.25.0
ignore:
  SNYK-JS-ZOD-20510278:
    - '* > zod@^3':
        reason: >-
          No fixed version is compatible: @a2ui/web_core and @a2ui/react (latest 0.13.0)
          require zod ^3.25.76, and the only fix is zod 4.6.6. The flagged function
          ($ZodArray / handleArrayResult) is in zod/v4/core, which neither MLflow nor @a2ui
          imports; they use the v3 API. Zod only runs client-side in the browser UI to
          validate A2UI trace messages, so the impact is limited to the viewer's own tab.
          Revisit when @a2ui supports zod 4.
        expires: 2027-01-13T00:00:00.000Z
        created: 2026-10-15T15:46:45.000Z
patch: {}
