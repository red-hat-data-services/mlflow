FROM registry.access.redhat.com/ubi9/python-311:9.6 AS python-builder
WORKDIR /src
USER 0
COPY --chown=1001:0 . .

# 4. Source Cachi2 for Python build tools
RUN set -eux; \
    if [ -f /cachi2/cachi2.env ]; then . /cachi2/cachi2.env; fi; \
    if [ -d /cachi2/output/deps/pip ]; then export PIP_FIND_LINKS="/cachi2/output/deps/pip"; export PIP_NO_INDEX=true; fi; \
    mkdir -p /src/requirements/ninja-archive; \
    cp requirements/ninja-v1.11.1.g95dee.kitware.jobserver-1.tar.gz /src/requirements/ninja-archive/v1.11.1.g95dee.kitware.jobserver-1.tar.gz; \
    export CMAKE_ARGS="-DARCHIVE_DOWNLOAD_DIR=/src/requirements/ninja-archive"; \
    export SKBUILD_CONFIGURE_OPTIONS="$CMAKE_ARGS"; \
    export MPLSETUPCFG=/src/requirements/matplotlib-setup.cfg; \
    export FREETYPE_DIR=/usr/lib64; \
    export QHULL_DIR=/usr/lib64; \
    export MESON_ARGS="--wrap-mode=nodownload"; \
    export PKG_CONFIG_PATH="${PKG_CONFIG_PATH:-/usr/lib64/pkgconfig:/usr/share/pkgconfig}"; \
    MPL_TARBALL="/cachi2/output/deps/pip/matplotlib-3.10.8.tar.gz"; \
    if [ -f "$MPL_TARBALL" ]; then \
        MPL_PATCHED_DIR="$(mktemp -d)"; \
        tar -xf "$MPL_TARBALL" -C "$MPL_PATCHED_DIR"; \
        sed -i "s/dependency('freetype2', required: false, method: 'pkg-config', fallback: \\['freetype', 'freetype_dep'\\])/dependency('freetype2', required: true, method: 'pkg-config')/" "$MPL_PATCHED_DIR/matplotlib-3.10.8/extern/meson.build"; \
        tar -czf "$MPL_PATCHED_DIR/matplotlib-3.10.8.tar.gz" -C "$MPL_PATCHED_DIR" matplotlib-3.10.8; \
        export PIP_FIND_LINKS="$MPL_PATCHED_DIR ${PIP_FIND_LINKS:-}"; \
    fi; \
    if [ -n "${PIP_FIND_LINKS:-}" ]; then \
        python -m pip wheel --no-cache-dir --no-index --find-links "$PIP_FIND_LINKS" \
            --wheel-dir /tmp/dist packaging==25.0 wheel==0.45.1; \
        export PIP_FIND_LINKS="/tmp/dist ${PIP_FIND_LINKS}"; \
    fi; \
    dnf install -y rust-toolset cmake ninja-build openblas openblas-devel freetype-devel libpng-devel; \
    python -m pip wheel --no-cache-dir --no-deps --wheel-dir /tmp/dist .; \
    python -m pip wheel --no-cache-dir --no-deps --wheel-dir /tmp/dist ./kubernetes-workspace-provider; \
    python -m pip wheel --no-cache-dir --wheel-dir /tmp/dist -r requirements/requirements.txt; \
    dnf clean all

FROM registry.access.redhat.com/ubi9/python-311:9.6
ARG MLFLOW_VERSION=3.3.2
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /app

USER 0
COPY --from=python-builder /tmp/dist/ /tmp/dist/
COPY requirements/requirements.txt /tmp/requirements.txt

# 5. Source Cachi2 for installing the final wheels and their dependencies (pandas, numpy, etc.)
RUN set -eux; \
    if [ -f /cachi2/cachi2.env ]; then . /cachi2/cachi2.env; fi; \
    python -m pip install --no-cache-dir --no-index --find-links /tmp/dist -r /tmp/requirements.txt && \
    python -m pip install --no-cache-dir --no-index --find-links /tmp/dist --no-deps /tmp/dist/mlflow-*.whl /tmp/dist/mlflow_kubernetes_workspace_provider-*.whl; \
    rm -rf /tmp/dist /tmp/requirements.txt

# Copy built UI from builder stage
# COPY --from=ui-builder /opt/app-root/src/build /tmp/mlflow-ui-build

# RUN set -eux; \
#     # Copy the UI build into the installed mlflow package
#     py_site=$(python -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])'); \
#     mkdir -p "$py_site/mlflow/server/js/build"; \
#     rm -rf "$py_site/mlflow/server/js/build"/* || true; \
#     cp -r /tmp/mlflow-ui-build/* "$py_site/mlflow/server/js/build/"; \
#     rm -rf /tmp/mlflow-ui-build

EXPOSE 5000

# Default command. Override in Kubernetes as needed.
USER 1001
CMD ["mlflow", "server", "--host", "0.0.0.0", "--port", "5000", "--app-name", "kubernetes-auth", "--enable-workspaces", "--workspace-store-uri", "kubernetes://", "--serve-artifacts"]

LABEL com.redhat.component="odh-mlflow-rhel9" \
      name="rhoai/odh-mlflow-rhel9" \
      description="odh-mlflow" \
      summary="odh-mlflow" \
      maintainer="['managed-open-data-hub@redhat.com']" \
      io.openshift.expose-services="" \
      io.k8s.display-name="odh-mlflow" \
      io.k8s.description="odh-mlflow" \
      com.redhat.license_terms="https://www.redhat.com/licenses/Red_Hat_Standard_EULA_20191108.pdf"
